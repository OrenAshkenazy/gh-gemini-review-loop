{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${GGRL_STATE_DIR:-$HOME/.config/gh-gemini-review-loop}/loop-active\"; [ -f \"$s\" ] || exit 0; [ -n \"$(find \"$s\" -mmin +1440 2>/dev/null)\" ] && { rm -f \"$s\"; exit 0; }; exec python3 \"${GGRL_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/skills/gh-review-loop/scripts/loop_profile_gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${GGRL_STATE_DIR:-$HOME/.config/gh-gemini-review-loop}/loop-active\"; [ -f \"$s\" ] || exit 0; [ -n \"$(find \"$s\" -mmin +1440 2>/dev/null)\" ] && { rm -f \"$s\"; exit 0; }; exec python3 \"${GGRL_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/skills/gh-review-loop/scripts/loop_summary_gate.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${GGRL_STATE_DIR:-$HOME/.config/gh-gemini-review-loop}/loop-active\"; [ -f \"$s\" ] || exit 0; [ -n \"$(find \"$s\" -mmin +1440 2>/dev/null)\" ] && { rm -f \"$s\"; exit 0; }; exec python3 \"${GGRL_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/skills/gh-review-loop/scripts/loop_summary_hook.py\"",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
