{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GGRL_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/skills/gh-review-loop/scripts/loop_profile_gate.py\"",
            "statusMessage": "Checking Gemini loop verification profile",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GGRL_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/skills/gh-review-loop/scripts/loop_summary_gate.py\"",
            "statusMessage": "Checking Gemini loop summary gate",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GGRL_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/skills/gh-review-loop/scripts/loop_summary_hook.py\"",
            "statusMessage": "Checking Gemini loop summary",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
